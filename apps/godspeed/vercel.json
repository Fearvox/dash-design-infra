{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ../.. && bun install --frozen-lockfile && bun run apps/godspeed/build",
  "outputDirectory": "dist",
  "installCommand": "echo 'install handled by buildCommand at workspace root'",
  "framework": null,
  "trailingSlash": false,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|avif|svg|ico|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/journal/feed.xml",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=600" },
        { "key": "Content-Type", "value": "application/rss+xml; charset=utf-8" }
      ]
    }
  ],
  "redirects": [
    { "source": "/instagram", "destination": "https://www.instagram.com/godspeedcola/", "permanent": false },
    { "source": "/ig", "destination": "https://www.instagram.com/godspeedcola/", "permanent": false },
    { "source": "/yelp", "destination": "https://www.yelp.com/biz/godspeed-coffee-columbia", "permanent": false }
  ]
}
